diff --git a/libavcodec/v4l2_enc_utils.c b/libavcodec/v4l2_enc_utils.c
new file mode 100644
index 0000000..c10bcd4
--- /dev/null
+++ b/libavcodec/v4l2_enc_utils.c
@@ -0,0 +1,175 @@
+/*
+ * V4L2 mem2mem encoder helpers that do not touch the device
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <string.h>
+
+#include "libavutil/common.h"
+#include "libavutil/error.h"
+#include "libavutil/imgutils.h"
+#include "libavutil/pixdesc.h"
+
+#include "v4l2_enc_utils.h"
+
+#define V4L2_ENC_MAX_PLANES 4
+
+typedef struct V4L2EncPlane {
+    uint8_t *data;
+    int stride;     /* bytes from one line to the next */
+    int rows;       /* lines in the format */
+    int bytes;      /* bytes of a line that the format's width covers */
+    int group;      /* bytes of one sample position (0: do not pad columns) */
+} V4L2EncPlane;
+
+static int plane_components(const AVPixFmtDescriptor *desc, int plane)
+{
+    int i, n = 0;
+
+    for (i = 0; i < desc->nb_components; i++)
+        n += desc->comp[i].plane == plane;
+    return n;
+}
+
+static int is_chroma_plane(int plane)
+{
+    return plane == 1 || plane == 2;
+}
+
+static int v4l2_enc_layout(enum AVPixelFormat fmt,
+                           uint8_t *const dst[], const size_t dst_len[],
+                           const int bytesperline[], int nb_mem_planes,
+                           int width, int height,
+                           V4L2EncPlane pl[V4L2_ENC_MAX_PLANES],
+                           size_t bytesused[])
+{
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(fmt);
+    int nb_planes = av_pix_fmt_count_planes(fmt);
+    size_t offset = 0;
+    int p;
+
+    if (!desc || (desc->flags & AV_PIX_FMT_FLAG_HWACCEL) ||
+        nb_planes <= 0 || nb_planes > V4L2_ENC_MAX_PLANES ||
+        width <= 0 || height <= 0)
+        return AVERROR(EINVAL);
+    if (nb_mem_planes != 1 && nb_mem_planes != nb_planes)
+        return AVERROR(EINVAL);
+
+    for (p = 0; p < nb_planes; p++) {
+        const int mp = nb_mem_planes > 1 ? p : 0;
+        const int chroma = is_chroma_plane(p);
+        int stride, bytes = av_image_get_linesize(fmt, width, p);
+
+        if (bytes < 0)
+            return bytes;
+
+        if (nb_mem_planes > 1) {
+            offset = 0;
+            stride = bytesperline[mp] > 0 ? bytesperline[mp] : bytes;
+        } else if (p == 0) {
+            stride = bytesperline[0] > 0 ? bytesperline[0] : bytes;
+        } else {
+            /*
+             * A plane that follows plane 0 in the same memory: its line
+             * length follows from plane 0's as the V4L2 specification
+             * derives it (NV12: the same, YUV420: half, P010: the same).
+             */
+            const int luma = bytesperline[0] > 0 ? bytesperline[0] :
+                             av_image_get_linesize(fmt, width, 0);
+            stride = (int)(((int64_t)luma * plane_components(desc, p) /
+                            FFMAX(plane_components(desc, 0), 1)) >>
+                           (chroma ? desc->log2_chroma_w : 0));
+        }
+        if (stride < bytes)
+            return AVERROR(EINVAL);
+
+        pl[p].data   = dst[mp] + offset;
+        pl[p].stride = stride;
+        pl[p].rows   = chroma ? AV_CEIL_RSHIFT(height, desc->log2_chroma_h) : height;
+        pl[p].bytes  = bytes;
+        pl[p].group  = nb_planes > 1 ?
+                       av_image_get_linesize(fmt, chroma ? 1 << desc->log2_chroma_w : 1, p) : 0;
+
+        if (offset > dst_len[mp] ||
+            (size_t)pl[p].stride * pl[p].rows > dst_len[mp] - offset)
+            return AVERROR(ENOSPC);
+
+        offset += (size_t)pl[p].stride * pl[p].rows;
+        bytesused[mp] = offset;
+    }
+
+    return nb_planes;
+}
+
+/* Repeat the last column and line of the picture into the format's padding. */
+static void v4l2_enc_pad_plane(const V4L2EncPlane *pl, int vis_bytes, int vis_rows)
+{
+    int x, y;
+
+    if (vis_rows <= 0 || vis_bytes <= 0)
+        return;
+
+    if (pl->group > 0 && vis_bytes >= pl->group && vis_bytes < pl->bytes) {
+        for (y = 0; y < vis_rows; y++) {
+            uint8_t *row = pl->data + (size_t)y * pl->stride;
+            const uint8_t *last = row + vis_bytes - pl->group;
+
+            for (x = vis_bytes; x + pl->group <= pl->bytes; x += pl->group)
+                memcpy(row + x, last, pl->group);
+        }
+    }
+
+    for (y = vis_rows; y < pl->rows; y++)
+        memcpy(pl->data + (size_t)y * pl->stride,
+               pl->data + (size_t)(vis_rows - 1) * pl->stride, pl->bytes);
+}
+
+int ff_v4l2_enc_copy_frame(const AVFrame *src, enum AVPixelFormat dst_fmt,
+                           uint8_t *const dst[], const size_t dst_len[],
+                           const int bytesperline[], int nb_mem_planes,
+                           int fmt_width, int fmt_height, size_t bytesused[])
+{
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(dst_fmt);
+    V4L2EncPlane pl[V4L2_ENC_MAX_PLANES];
+    const int w = FFMIN(src->width,  fmt_width);
+    const int h = FFMIN(src->height, fmt_height);
+    int p, nb_planes;
+
+    if (src->format != dst_fmt || w <= 0 || h <= 0)
+        return AVERROR(EINVAL);
+
+    nb_planes = v4l2_enc_layout(dst_fmt, dst, dst_len, bytesperline,
+                                nb_mem_planes, fmt_width, fmt_height,
+                                pl, bytesused);
+    if (nb_planes < 0)
+        return nb_planes;
+
+    for (p = 0; p < nb_planes; p++) {
+        const int rows  = is_chroma_plane(p) ? AV_CEIL_RSHIFT(h, desc->log2_chroma_h) : h;
+        const int bytes = av_image_get_linesize(dst_fmt, w, p);
+
+        if (!src->data[p] || bytes < 0)
+            return AVERROR(EINVAL);
+
+        av_image_copy_plane(pl[p].data, pl[p].stride,
+                            src->data[p], src->linesize[p], bytes, rows);
+        v4l2_enc_pad_plane(&pl[p], bytes, rows);
+    }
+
+    return 0;
+}
