+/*
+ * An emulation of a reordering encoder: the B-frame planner of the Apple AVE
+ * V4L2 driver (ave_gop.h), fed frames in presentation order. It holds up to
+ * nb frames as B frames until their anchor (a P) arrives, then codes the
+ * group anchor first; an IDR (the first frame, every gop frames) first
+ * closes the held frames as Bs + a P. With know_last the driver learns
+ * which frame is the last when it arrives (the last is an anchor);
+ * otherwise the drain closes what it holds. order[] gets each group's
+ * frames in decode order; shuffle permutes every group at random instead,
+ * which the DTS must also survive.
+ */
+typedef struct Emu {
+    int nb, gop, know_last, shuffle;
+    int held[8], n_held, dist, started;
+    int order[4096], n_order;
+    int groups[4096], n_groups;  /* order index where each group ends */
+    unsigned rnd;
+} Emu;
+
+static unsigned emu_rand(Emu *e)
+{
+    e->rnd = e->rnd * 1664525u + 1013904223u;
+    return e->rnd >> 8;
+}
+
+static void emu_group(Emu *e, const int *frames, int n)
+{
+    int i, start = e->n_order;
+
+    for (i = 0; i < n; i++)
+        e->order[e->n_order++] = frames[i];
+    if (e->shuffle) {
+        for (i = n - 1; i > 0; i--) {
+            int j = emu_rand(e) % (i + 1), t = e->order[start + i];
+            e->order[start + i] = e->order[start + j];
+            e->order[start + j] = t;
+        }
+    }
+    e->groups[e->n_groups++] = e->n_order;
+}
+
+/* held Bs and their P: the P (the newest) first, then the Bs */
+static void emu_close(Emu *e, int with_new, int new_frame)
+{
+    int g[8], n = 0, i;
+
+    if (with_new) {
+        g[n++] = new_frame;
+        for (i = 0; i < e->n_held; i++)
+            g[n++] = e->held[i];
+    } else if (e->n_held) {
+        g[n++] = e->held[e->n_held - 1];
+        for (i = 0; i < e->n_held - 1; i++)
+            g[n++] = e->held[i];
+    }
+    if (n)
+        emu_group(e, g, n);
+    e->n_held = 0;
+}
+
+static void emu_frame(Emu *e, int f, int last)
+{
+    if (!e->started || (e->gop && e->dist >= e->gop)) {
+        emu_close(e, 0, 0);
+        emu_group(e, &f, 1);              /* the IDR, alone */
+        e->started = 1;
+        e->dist = 1;
+    } else if ((last && e->know_last) || e->n_held >= e->nb ||
+               (e->gop && e->dist + 1 >= e->gop)) {
+        emu_close(e, 1, f);
+        e->dist++;
+    } else {
+        e->held[e->n_held++] = f;
+        e->dist++;
+    }
+}
+
+/*
+ * Run n frames through the emulation and the DTS derivation; return the
+ * number of packets whose DTS is above their PTS or not above the previous
+ * DTS (reported unless quiet), or -1 on a bookkeeping failure.
+ */
+static int run_dts(int nb, int delay, int gop, int n, int know_last, int shuffle,
+                   int vfr, int64_t start, int quiet)
+{
+    Emu e = { .nb = nb, .gop = gop, .know_last = know_last, .shuffle = shuffle,
+              .rnd = 12345u + n * 7u + gop };
+    V4L2EncTimestamps ts = { 0 };
+    int64_t pts[4096], prev_dts = INT64_MIN;
+    int i, g = 0, out = 0, bad = 0;
+
+    pts[0] = start;
+    for (i = 1; i < n; i++)
+        pts[i] = pts[i - 1] + (vfr ? 1 + emu_rand(&e) % 5 : 3);
+
+    if (ff_v4l2_enc_ts_init(&ts, delay, 3) < 0)
+        return -1;
+    for (i = 0; i < n; i++) {
+        emu_frame(&e, i, i == n - 1);
+        if (i == n - 1)
+            emu_close(&e, 0, 0);          /* the drain */
+        if (ff_v4l2_enc_ts_push(&ts, pts[i]) < 0)
+            goto fail;
+        /* the packets of every group complete so far come back now */
+        for (; g < e.n_groups; g++) {
+            for (; out < e.groups[g]; out++) {
+                int64_t dts, p = pts[e.order[out]];
+
+                if (ff_v4l2_enc_ts_next_dts(&ts, &dts) < 0)
+                    goto fail;
+                if (dts > p || dts <= prev_dts || (!delay && dts != p)) {
+                    if (!quiet && bad < 3)
+                        CHECK(0, "nb %d delay %d gop %d n %d last %d shuffle %d: packet %d "
+                              "(frame %d) PTS %"PRId64" DTS %"PRId64" previous DTS %"PRId64,
+                              nb, delay, gop, n, know_last, shuffle, out, e.order[out],
+                              p, dts, prev_dts);
+                    bad++;
+                }
+                prev_dts = dts;
+            }
+        }
+        /* never more than the held B frames in flight */
+        if (ff_v4l2_enc_ts_in_flight(&ts) > nb)
+            goto fail;
+    }
+    if (out != n || ff_v4l2_enc_ts_in_flight(&ts))
+        goto fail;
+    ff_v4l2_enc_ts_uninit(&ts);
+    return bad;
+fail:
+    ff_v4l2_enc_ts_uninit(&ts);
+    return -1;
+}
+
+static void test_dts(void)
+{
+    static const int gops[]     = { 0, 1, 2, 3, 4, 5, 12, 250 };
+    static const int counts[]   = { 1, 2, 3, 4, 7, 60, 1000 };
+    static const int64_t starts[] = { 0, -7, 90000 };
+    int nb, gi, ci, si, last, shuffle, vfr, ret, control = 0;
+
+    for (nb = 0; nb <= 2; nb++)
+        for (gi = 0; gi < FF_ARRAY_ELEMS(gops); gi++)
+            for (ci = 0; ci < FF_ARRAY_ELEMS(counts); ci++)
+                for (last = 0; last <= 1; last++)
+                    for (shuffle = 0; shuffle <= 1; shuffle++)
+                        for (vfr = 0; vfr <= 1; vfr++) {
+                            for (si = 0; si < FF_ARRAY_ELEMS(starts); si++) {
+                                ret = run_dts(nb, nb, gops[gi], counts[ci], last,
+                                              shuffle, vfr, starts[si], 0);
+                                CHECK(ret == 0, "nb %d gop %d n %d: %d bad DTS",
+                                      nb, gops[gi], counts[ci], ret);
+                            }
+                            /* the driver may code fewer B frames than it accepted */
+                            ret = run_dts(nb, 2, gops[gi], counts[ci], last,
+                                          shuffle, vfr, 0, 0);
+                            CHECK(ret == 0, "nb %d delay 2: %d bad DTS", nb, ret);
+                            /* control: B frames without a reorder delay must fail
+                             * (unshuffled: a shuffle may put a group back in order) */
+                            if (nb && !shuffle && counts[ci] >= 7 && gops[gi] != 1 && gops[gi] != 2) {
+                                ret = run_dts(nb, 0, gops[gi], counts[ci], last,
+                                              shuffle, vfr, 0, 1);
+                                CHECK(ret > 0, "control passed: nb %d delay 0 gop %d n %d",
+                                      nb, gops[gi], counts[ci]);
+                                control++;
+                            }
+                        }
+    CHECK(control > 0, "no control ran");
+
+    /* delay 1 is exact for anchor-first groups (x264's has_b_frames without pyramid) */
+    for (nb = 1; nb <= 2; nb++) {
+        ret = run_dts(nb, 1, 250, 1000, 0, 0, 0, 0, 0);
+        CHECK(ret == 0, "nb %d delay 1, anchor first: %d bad DTS", nb, ret);
+    }
+
+    /* the exact sequence for B=1: I0 P2 B1 P4 B3 ... */
+    {
+        V4L2EncTimestamps ts = { 0 };
+        static const int order[] = { 0, 2, 1, 4, 3, 5 };
+        static const int64_t want[] = { -1, 0, 1, 2, 3, 4 };
+        int64_t dts;
+        int i;
+
+        ff_v4l2_enc_ts_init(&ts, 1, 1);
+        for (i = 0; i < 6; i++)
+            ff_v4l2_enc_ts_push(&ts, i);
+        for (i = 0; i < 6; i++) {
+            ff_v4l2_enc_ts_next_dts(&ts, &dts);
+            CHECK(dts == want[i] && dts <= order[i], "B=1 packet %d: DTS %"PRId64, i, dts);
+        }
+        ff_v4l2_enc_ts_uninit(&ts);
+    }
+}
+
+static void test_has_picture(void)
+{
+    static const uint8_t h264_hdr[] = { 0, 0, 0, 1, 0x67, 0x64, 0x00, 0x28, 0, 0, 1, 0x68, 0xee, 0x3c, 0x80 };
+    static const uint8_t h264_idr[] = { 0, 0, 0, 1, 0x67, 0x64, 0, 0, 0, 1, 0x68, 0xee,
+                                        0, 0, 1, 0x65, 0x88, 0x84, 0x00 };
+    static const uint8_t h264_b[]   = { 0, 0, 0, 1, 0x01, 0x9e, 0x12 };
+    static const uint8_t hevc_hdr[] = { 0, 0, 0, 1, 0x40, 0x01, 0x0c, 0, 0, 0, 1, 0x42, 0x01, 0x01,
+                                        0, 0, 0, 1, 0x44, 0x01, 0xc1, 0, 0, 0, 1, 0x4e, 0x01, 0x05 };
+    static const uint8_t hevc_idr[] = { 0, 0, 0, 1, 0x40, 0x01, 0x0c, 0, 0, 0, 1, 0x26, 0x01, 0xaf };
+    static const uint8_t hevc_trail[] = { 0, 0, 1, 0x02, 0x01, 0xd0, 0x00, 0x00 };
+
+    CHECK(!ff_v4l2_enc_has_picture(AV_CODEC_ID_H264, h264_hdr, sizeof(h264_hdr)), "h264 hdr");
+    CHECK(ff_v4l2_enc_has_picture(AV_CODEC_ID_H264, h264_idr, sizeof(h264_idr)), "h264 idr");
+    CHECK(ff_v4l2_enc_has_picture(AV_CODEC_ID_H264, h264_b, sizeof(h264_b)), "h264 b");
+    CHECK(!ff_v4l2_enc_has_picture(AV_CODEC_ID_HEVC, hevc_hdr, sizeof(hevc_hdr)), "hevc hdr");
+    CHECK(ff_v4l2_enc_has_picture(AV_CODEC_ID_HEVC, hevc_idr, sizeof(hevc_idr)), "hevc idr");
+    CHECK(ff_v4l2_enc_has_picture(AV_CODEC_ID_HEVC, hevc_trail, sizeof(hevc_trail)), "hevc trail");
+    CHECK(ff_v4l2_enc_has_picture(AV_CODEC_ID_VP8, h264_hdr, sizeof(h264_hdr)), "vp8");
+}
+
 int main(void)
 {
     test_copy();
     test_convert();
+    test_dts();
+    test_has_picture();
 
     if (failures) {
         fprintf(stderr, "%d failure(s)\n", failures);
