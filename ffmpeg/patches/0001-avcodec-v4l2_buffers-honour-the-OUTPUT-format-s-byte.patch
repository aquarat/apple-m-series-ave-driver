new file mode 100644
index 0000000..96ffcee
--- /dev/null
+++ b/libavcodec/tests/v4l2_enc_utils.c
@@ -0,0 +1,254 @@
+/*
+ * Tests for the V4L2 mem2mem encoder helpers (no device needed)
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "libavutil/frame.h"
+#include "libavutil/mem.h"
+
+#include "libavcodec/v4l2_enc_utils.c"
+
+static int failures;
+
+#define CHECK(cond, ...) do {                                   \
+        if (!(cond)) {                                          \
+            fprintf(stderr, "FAIL %s:%d: ", __FILE__, __LINE__); \
+            fprintf(stderr, __VA_ARGS__);                       \
+            fprintf(stderr, "\n");                              \
+            failures++;                                         \
+        }                                                       \
+    } while (0)
+
+/* A value that differs between planes, lines and columns. */
+static uint8_t pattern(int plane, int x, int y)
+{
+    return (uint8_t)(plane * 71 + x * 7 + y * 13 + (x * y >> 3));
+}
+
+static AVFrame *make_frame(enum AVPixelFormat fmt, int w, int h)
+{
+    AVFrame *f = av_frame_alloc();
+    int p, x, y, nb_planes = av_pix_fmt_count_planes(fmt);
+
+    if (!f)
+        return NULL;
+    f->format = fmt;
+    f->width  = w;
+    f->height = h;
+    /* a large alignment, so linesize != width */
+    if (av_frame_get_buffer(f, 128) < 0) {
+        av_frame_free(&f);
+        return NULL;
+    }
+    for (p = 0; p < nb_planes; p++) {
+        const AVPixFmtDescriptor *d = av_pix_fmt_desc_get(fmt);
+        int rows  = is_chroma_plane(p) ? AV_CEIL_RSHIFT(h, d->log2_chroma_h) : h;
+        int bytes = av_image_get_linesize(fmt, w, p);
+
+        for (y = 0; y < rows; y++)
+            for (x = 0; x < bytes; x++)
+                f->data[p][y * f->linesize[p] + x] = pattern(p, x, y);
+    }
+    return f;
+}
+
+/*
+ * Copy a w x h frame into a buffer whose format is fw x fh with the given
+ * bytesperline (one memory plane), and check every byte the encoder reads
+ * against a layout computed here independently:
+ * plane p starts at off[p] with stride[p] and has rows[p] lines.
+ */
+static void check_contiguous(const char *name, enum AVPixelFormat fmt,
+                             int w, int h, int fw, int fh, int bpl,
+                             const size_t off[], const int stride[],
+                             const int rows[], const int vis_rows[],
+                             const int bytes[], const int vis_bytes[],
+                             const int group[], size_t len)
+{
+    AVFrame *f = make_frame(fmt, w, h);
+    uint8_t *buf = av_mallocz(len);
+    uint8_t *dst[1] = { buf };
+    size_t dst_len[1] = { len }, used[1] = { 0 };
+    int p, x, y, ret, nb_planes = av_pix_fmt_count_planes(fmt);
+    int bad = 0;
+
+    if (!f || !buf) {
+        CHECK(0, "%s: out of memory", name);
+        goto end;
+    }
+    memset(buf, 0xEE, len);
+    ret = ff_v4l2_enc_copy_frame(f, fmt, dst, dst_len, &bpl, 1, fw, fh, used);
+    CHECK(ret == 0, "%s: copy returned %d", name, ret);
+    if (ret)
+        goto end;
+    CHECK(used[0] == off[nb_planes - 1] + (size_t)stride[nb_planes - 1] * rows[nb_planes - 1],
+          "%s: bytesused %zu", name, used[0]);
+
+    for (p = 0; p < nb_planes; p++) {
+        for (y = 0; y < rows[p] && bad < 10; y++) {
+            for (x = 0; x < bytes[p] && bad < 10; x++) {
+                int sx = x, sy = FFMIN(y, vis_rows[p] - 1);
+                uint8_t got = buf[off[p] + (size_t)y * stride[p] + x];
+
+                if (sx >= vis_bytes[p])     /* padded column: the last sample position */
+                    sx = vis_bytes[p] - group[p] + (x - vis_bytes[p]) % group[p];
+                if (got != pattern(p, sx, sy)) {
+                    CHECK(0, "%s: plane %d (%d,%d) = %d, want %d (source %d,%d)",
+                          name, p, x, y, got, pattern(p, sx, sy), sx, sy);
+                    bad++;
+                }
+            }
+        }
+    }
+    /* nothing written past the last plane */
+    for (x = (int)used[0]; x < (int)len && x < (int)used[0] + 64; x++)
+        if (buf[x] != 0xEE) {
+            CHECK(0, "%s: wrote past bytesused at %d", name, x);
+            break;
+        }
+end:
+    av_frame_free(&f);
+    av_free(buf);
+}
+
+static void test_copy(void)
+{
+    /* SD: 720 wide, the driver's bytesperline is 768 (64-aligned) */
+    {
+        const size_t off[]    = { 0, 768 * 576 };
+        const int stride[]    = { 768, 768 };
+        const int rows[]      = { 576, 288 }, vis_rows[] = { 576, 288 };
+        const int bytes[]     = { 720, 720 }, vis_bytes[] = { 720, 720 };
+        const int group[]     = { 1, 2 };
+        check_contiguous("nv12 720x576 bpl 768", AV_PIX_FMT_NV12, 720, 576, 720, 576,
+                         768, off, stride, rows, vis_rows, bytes, vis_bytes, group,
+                         768 * 576 * 3 / 2);
+    }
+    /* 1080 lines: the driver rounds the height to 1088 */
+    {
+        const size_t off[]    = { 0, 1920 * 1088 };
+        const int stride[]    = { 1920, 1920 };
+        const int rows[]      = { 1088, 544 }, vis_rows[] = { 1080, 540 };
+        const int bytes[]     = { 1920, 1920 }, vis_bytes[] = { 1920, 1920 };
+        const int group[]     = { 1, 2 };
+        check_contiguous("nv12 1920x1080 in 1920x1088", AV_PIX_FMT_NV12, 1920, 1080,
+                         1920, 1088, 1920, off, stride, rows, vis_rows, bytes,
+                         vis_bytes, group, 1920 * 1088 * 3 / 2);
+    }
+    /* HEVC sizing: chroma still at bytesperline * height, slack after it */
+    {
+        const size_t off[]    = { 0, 768 * 576 };
+        const int stride[]    = { 768, 768 };
+        const int rows[]      = { 576, 288 }, vis_rows[] = { 576, 288 };
+        const int bytes[]     = { 720, 720 }, vis_bytes[] = { 720, 720 };
+        const int group[]     = { 1, 2 };
+        check_contiguous("nv12 720x576 hevc slack", AV_PIX_FMT_NV12, 720, 576, 720, 576,
+                         768, off, stride, rows, vis_rows, bytes, vis_bytes, group,
+                         768 * 576 + 768 * (FFALIGN(576, 64) / 2));
+    }
+    /* width and height both padded: 1916x1078 in 1920x1088 */
+    {
+        const size_t off[]    = { 0, 1984 * 1088 };
+        const int stride[]    = { 1984, 1984 };
+        const int rows[]      = { 1088, 544 }, vis_rows[] = { 1078, 539 };
+        const int bytes[]     = { 1920, 1920 }, vis_bytes[] = { 1916, 1916 };
+        const int group[]     = { 1, 2 };
+        check_contiguous("nv12 1916x1078 in 1920x1088", AV_PIX_FMT_NV12, 1916, 1078,
+                         1920, 1088, 1984, off, stride, rows, vis_rows, bytes,
+                         vis_bytes, group, 1984 * 1088 * 3 / 2);
+    }
+    /* P010: two bytes a sample */
+    {
+        const size_t off[]    = { 0, 1536 * 576 };
+        const int stride[]    = { 1536, 1536 };
+        const int rows[]      = { 576, 288 }, vis_rows[] = { 576, 288 };
+        const int bytes[]     = { 1440, 1440 }, vis_bytes[] = { 1440, 1440 };
+        const int group[]     = { 2, 4 };
+        check_contiguous("p010 720x576 bpl 1536", AV_PIX_FMT_P010LE, 720, 576, 720, 576,
+                         1536, off, stride, rows, vis_rows, bytes, vis_bytes, group,
+                         1536 * 576 * 3 / 2);
+    }
+    /* single-planar YUV420 (I420): chroma lines are half of bytesperline */
+    {
+        const size_t off[]    = { 0, 768 * 576, 768 * 576 + 384 * 288 };
+        const int stride[]    = { 768, 384, 384 };
+        const int rows[]      = { 576, 288, 288 }, vis_rows[] = { 576, 288, 288 };
+        const int bytes[]     = { 720, 360, 360 }, vis_bytes[] = { 720, 360, 360 };
+        const int group[]     = { 1, 1, 1 };
+        check_contiguous("yuv420p 720x576 bpl 768", AV_PIX_FMT_YUV420P, 720, 576, 720, 576,
+                         768, off, stride, rows, vis_rows, bytes, vis_bytes, group,
+                         768 * 576 * 3 / 2);
+    }
+
+    /* a buffer too small is refused, not overrun */
+    {
+        AVFrame *f = make_frame(AV_PIX_FMT_NV12, 720, 576);
+        size_t len = 768 * 576, used[1];
+        uint8_t *buf = av_malloc(len), *dst[1] = { buf };
+        int bpl = 768;
+
+        CHECK(f && buf, "oom");
+        if (f && buf)
+            CHECK(ff_v4l2_enc_copy_frame(f, AV_PIX_FMT_NV12, dst, &len, &bpl, 1,
+                                         720, 576, used) == AVERROR(ENOSPC),
+                  "short buffer accepted");
+        av_frame_free(&f);
+        av_free(buf);
+    }
+
+    /* two memory planes (NV12M), each with its own bytesperline */
+    {
+        AVFrame *f = make_frame(AV_PIX_FMT_NV12, 720, 576);
+        size_t len[2] = { 768 * 576, 832 * 288 }, used[2] = { 0 };
+        uint8_t *y = av_mallocz(len[0]), *uv = av_mallocz(len[1]);
+        uint8_t *dst[2] = { y, uv };
+        int bpl[2] = { 768, 832 }, ret, i, bad = 0;
+
+        if (f && y && uv) {
+            ret = ff_v4l2_enc_copy_frame(f, AV_PIX_FMT_NV12, dst, len, bpl, 2,
+                                         720, 576, used);
+            CHECK(ret == 0 && used[0] == len[0] && used[1] == len[1],
+                  "nv12m: ret %d used %zu %zu", ret, used[0], used[1]);
+            for (i = 0; i < 720 * 576 && !bad; i++)
+                bad |= y[(i / 720) * 768 + i % 720] != pattern(0, i % 720, i / 720);
+            for (i = 0; i < 720 * 288 && !bad; i++)
+                bad |= uv[(i / 720) * 832 + i % 720] != pattern(1, i % 720, i / 720);
+            CHECK(!bad, "nv12m: wrong sample");
+        } else
+            CHECK(0, "oom");
+        av_frame_free(&f);
+        av_free(y);
+        av_free(uv);
+    }
+}
+
+int main(void)
+{
+    test_copy();
+
+    if (failures) {
+        fprintf(stderr, "%d failure(s)\n", failures);
+        return 1;
+    }
+    printf("v4l2_enc_utils: all tests passed\n");
+    return 0;
+}
