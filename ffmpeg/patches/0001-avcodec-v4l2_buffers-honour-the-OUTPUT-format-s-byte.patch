+#ifndef AVCODEC_V4L2_ENC_UTILS_H
+#define AVCODEC_V4L2_ENC_UTILS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "libavutil/frame.h"
+#include "libavutil/pixfmt.h"
+
+/**
+ * Copy a software frame into the memory of a V4L2 OUTPUT buffer, laid out
+ * as the driver's format describes it.
+ *
+ * With one memory plane (single-planar NV12, P010, YUV420, ...) the planes
+ * are contiguous: plane 0 has bytesperline[0] bytes per line and fmt_height
+ * lines, the chroma planes follow at bytesperline[0] * fmt_height with the
+ * chroma line length the V4L2 specification derives from bytesperline[0].
+ * With several memory planes (NV12M, YUV420M, ...) every plane has its own
+ * memory and bytesperline.
+ *
+ * Only the frame's own lines and columns are read from it. When the format
+ * is larger than the frame (the driver rounded it up to whole macroblocks),
+ * the last column and line are repeated into the padding, which the encoder
+ * codes and the stream's cropping hides.
+ *
+ * @param src           the frame
+ * @param dst_fmt       the buffer's pixel format
+ * @param dst           base address of each memory plane
+ * @param dst_len       length of each memory plane
+ * @param bytesperline  bytesperline of each memory plane (0: tightly packed)
+ * @param nb_mem_planes number of memory planes
+ * @param fmt_width     the format's width
+ * @param fmt_height    the format's height
+ * @param bytesused     out: bytes used in each memory plane
+ * @return 0 on success, a negative AVERROR code otherwise
+ */
+int ff_v4l2_enc_copy_frame(const AVFrame *src, enum AVPixelFormat dst_fmt,
+                           uint8_t *const dst[], const size_t dst_len[],
+                           const int bytesperline[], int nb_mem_planes,
+                           int fmt_width, int fmt_height, size_t bytesused[]);
+
+#endif /* AVCODEC_V4L2_ENC_UTILS_H */
