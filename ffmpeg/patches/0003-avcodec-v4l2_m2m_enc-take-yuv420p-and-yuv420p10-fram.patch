From c28c2eebe1dc03ed711da9c8d685d6ac730a6c52 Mon Sep 17 00:00:00 2001
From: aquarat <3090997+aquarat@users.noreply.github.com>
Date: Sun, 4 Oct 2026 18:34:29 +0100
Subject: [PATCH 3/7] avcodec/v4l2_m2m_enc: take yuv420p and yuv420p10 frames
 for NV12/P010 devices

The encoders declare no pixel formats, so ffmpeg hands them whatever the
decoder produced, which for nearly every 4:2:0 source is yuv420p; with a
device that takes only NV12 (most of them) the encoder then refused to
open until the user added -pix_fmt nv12.

Interleave the chroma while copying instead: yuv420p frames go into NV12
(or NV21) buffers and yuv420p10le frames into P010 buffers, which is no
more work than the copy itself. 10-bit frames ask the driver for P010,
since V4L2 has no planar 10-bit format of its own. Other formats still
need converting before the encoder, and the error now says how.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AGB1JqfDntxCaB5cKZV4vM
---
 libavcodec/tests/v4l2_enc_utils.c | 85 +++++++++++++++++++++++++++++++
 libavcodec/v4l2_enc_utils.c       | 83 ++++++++++++++++++++++++++++--
 libavcodec/v4l2_enc_utils.h       | 16 +++++-
 libavcodec/v4l2_m2m_enc.c         | 17 +++++--
 4 files changed, 192 insertions(+), 9 deletions(-)

diff --git a/libavcodec/tests/v4l2_enc_utils.c b/libavcodec/tests/v4l2_enc_utils.c
index 96ffcee..266d938 100644
--- a/libavcodec/tests/v4l2_enc_utils.c
+++ b/libavcodec/tests/v4l2_enc_utils.c
@@ -241,9 +241,94 @@ static void test_copy(void)
     }
 }
 
+/* yuv420p -> NV12 and yuv420p10 -> P010 while copying, with padding */
+static void test_convert(void)
+{
+    const int w = 718, h = 574, fw = 720, fh = 576, bpl = 768;
+    AVFrame *f = make_frame(AV_PIX_FMT_YUV420P, w, h);
+    size_t len = (size_t)bpl * fh * 3 / 2, used[1];
+    uint8_t *buf = av_mallocz(len), *dst[1] = { buf };
+    int x, y, bad = 0, b = bpl;
+
+    CHECK(ff_v4l2_enc_can_convert(AV_PIX_FMT_YUV420P, AV_PIX_FMT_NV12), "can_convert");
+    CHECK(!ff_v4l2_enc_can_convert(AV_PIX_FMT_YUV422P, AV_PIX_FMT_NV12), "can_convert 422");
+    CHECK(ff_v4l2_enc_request_fmt(AV_PIX_FMT_YUV420P10LE) == AV_PIX_FMT_P010LE, "request_fmt");
+
+    if (!f || !buf) {
+        CHECK(0, "oom");
+        goto p010;
+    }
+    CHECK(!ff_v4l2_enc_copy_frame(f, AV_PIX_FMT_NV12, dst, &len, &b, 1, fw, fh, used),
+          "yuv420p->nv12 failed");
+    for (y = 0; y < fh && bad < 5; y++)
+        for (x = 0; x < fw && bad < 5; x++) {
+            int sx = FFMIN(x, w - 1), sy = FFMIN(y, h - 1);
+            if (buf[y * bpl + x] != pattern(0, sx, sy)) {
+                CHECK(0, "nv12 Y (%d,%d)", x, y);
+                bad++;
+            }
+        }
+    for (y = 0; y < fh / 2 && bad < 5; y++)
+        for (x = 0; x < fw / 2 && bad < 5; x++) {
+            int sx = FFMIN(x, w / 2 - 1), sy = FFMIN(y, h / 2 - 1);
+            const uint8_t *uv = buf + bpl * fh + y * bpl + 2 * x;
+            if (uv[0] != pattern(1, sx, sy) || uv[1] != pattern(2, sx, sy)) {
+                CHECK(0, "nv12 UV (%d,%d): %d %d want %d %d", x, y, uv[0], uv[1],
+                      pattern(1, sx, sy), pattern(2, sx, sy));
+                bad++;
+            }
+        }
+
+p010:
+    av_frame_free(&f);
+    av_free(buf);
+
+    /* yuv420p10 -> P010 */
+    {
+        const int pw = 720, ph = 576, pbpl = 1536;
+        AVFrame *g = av_frame_alloc();
+        size_t plen = (size_t)pbpl * ph * 3 / 2;
+        uint8_t *pbuf = av_mallocz(plen), *pdst[1] = { pbuf };
+        int pb = pbpl;
+
+        if (!g || !pbuf)
+            goto end;
+        g->format = AV_PIX_FMT_YUV420P10LE;
+        g->width  = pw;
+        g->height = ph;
+        if (av_frame_get_buffer(g, 64) < 0)
+            goto end;
+        for (y = 0; y < ph; y++)
+            for (x = 0; x < pw; x++)
+                AV_WL16(g->data[0] + y * g->linesize[0] + 2 * x, (x * 3 + y) & 1023);
+        for (y = 0; y < ph / 2; y++)
+            for (x = 0; x < pw / 2; x++) {
+                AV_WL16(g->data[1] + y * g->linesize[1] + 2 * x, (x + 5 * y) & 1023);
+                AV_WL16(g->data[2] + y * g->linesize[2] + 2 * x, (7 * x + y) & 1023);
+            }
+        CHECK(!ff_v4l2_enc_copy_frame(g, AV_PIX_FMT_P010LE, pdst, &plen, &pb, 1, pw, ph, used),
+              "yuv420p10->p010 failed");
+        bad = 0;
+        for (y = 0; y < ph && !bad; y++)
+            for (x = 0; x < pw && !bad; x++)
+                bad |= AV_RL16(pbuf + y * pbpl + 2 * x) != (((x * 3 + y) & 1023) << 6);
+        for (y = 0; y < ph / 2 && !bad; y++)
+            for (x = 0; x < pw / 2 && !bad; x++) {
+                const uint8_t *uv = pbuf + pbpl * ph + y * pbpl + 4 * x;
+                bad |= AV_RL16(uv)     != (((x + 5 * y) & 1023) << 6) ||
+                       AV_RL16(uv + 2) != (((7 * x + y) & 1023) << 6);
+            }
+        CHECK(!bad, "p010 sample wrong at (%d,%d)", x, y);
+end:
+        av_frame_free(&g);
+        av_free(pbuf);
+    }
+}
+
 int main(void)
 {
     test_copy();
+    test_convert();
 
     if (failures) {
         fprintf(stderr, "%d failure(s)\n", failures);
diff --git a/libavcodec/v4l2_enc_utils.c b/libavcodec/v4l2_enc_utils.c
index c10bcd4..81ca078 100644
--- a/libavcodec/v4l2_enc_utils.c
+++ b/libavcodec/v4l2_enc_utils.c
@@ -23,6 +23,7 @@
 #include "libavutil/common.h"
 #include "libavutil/error.h"
 #include "libavutil/imgutils.h"
+#include "libavutil/intreadwrite.h"
 #include "libavutil/pixdesc.h"
 
 #include "v4l2_enc_utils.h"
@@ -139,6 +140,69 @@ static void v4l2_enc_pad_plane(const V4L2EncPlane *pl, int vis_bytes, int vis_ro
                pl->data + (size_t)(vis_rows - 1) * pl->stride, pl->bytes);
 }
 
+int ff_v4l2_enc_can_convert(enum AVPixelFormat src, enum AVPixelFormat dst)
+{
+    if (src == dst)
+        return 1;
+    switch (src) {
+    case AV_PIX_FMT_YUV420P:
+        return dst == AV_PIX_FMT_NV12 || dst == AV_PIX_FMT_NV21;
+    case AV_PIX_FMT_YUV420P10LE:
+        return dst == AV_PIX_FMT_P010LE;
+    default:
+        return 0;
+    }
+}
+
+enum AVPixelFormat ff_v4l2_enc_request_fmt(enum AVPixelFormat src)
+{
+    /* 10-bit 4:2:0 has no V4L2 format of its own; P010 holds it as is */
+    return src == AV_PIX_FMT_YUV420P10LE ? AV_PIX_FMT_P010LE : src;
+}
+
+/* Planar 4:2:0 into the semi-planar layout: the same luma, interleaved chroma. */
+static void v4l2_enc_convert(const AVFrame *src, enum AVPixelFormat dst_fmt,
+                             const V4L2EncPlane pl[], int w, int h)
+{
+    const int cw = AV_CEIL_RSHIFT(w, 1), ch = AV_CEIL_RSHIFT(h, 1);
+    const int swap = dst_fmt == AV_PIX_FMT_NV21;
+    int x, y;
+
+    if (dst_fmt == AV_PIX_FMT_P010LE) {
+        /* P010: the 10 bits sit at the top of each 16-bit sample */
+        for (y = 0; y < h; y++) {
+            const uint8_t *s = src->data[0] + (ptrdiff_t)y * src->linesize[0];
+            uint8_t *d = pl[0].data + (size_t)y * pl[0].stride;
+
+            for (x = 0; x < w; x++)
+                AV_WL16(d + 2 * x, AV_RL16(s + 2 * x) << 6);
+        }
+        for (y = 0; y < ch; y++) {
+            const uint8_t *u = src->data[1] + (ptrdiff_t)y * src->linesize[1];
+            const uint8_t *v = src->data[2] + (ptrdiff_t)y * src->linesize[2];
+            uint8_t *d = pl[1].data + (size_t)y * pl[1].stride;
+
+            for (x = 0; x < cw; x++) {
+                AV_WL16(d + 4 * x,     AV_RL16(u + 2 * x) << 6);
+                AV_WL16(d + 4 * x + 2, AV_RL16(v + 2 * x) << 6);
+            }
+        }
+        return;
+    }
+
+    av_image_copy_plane(pl[0].data, pl[0].stride, src->data[0], src->linesize[0], w, h);
+    for (y = 0; y < ch; y++) {
+        const uint8_t *u = src->data[swap ? 2 : 1] + (ptrdiff_t)y * src->linesize[swap ? 2 : 1];
+        const uint8_t *v = src->data[swap ? 1 : 2] + (ptrdiff_t)y * src->linesize[swap ? 1 : 2];
+        uint8_t *d = pl[1].data + (size_t)y * pl[1].stride;
+
+        for (x = 0; x < cw; x++) {
+            d[2 * x]     = u[x];
+            d[2 * x + 1] = v[x];
+        }
+    }
+}
+
 int ff_v4l2_enc_copy_frame(const AVFrame *src, enum AVPixelFormat dst_fmt,
                            uint8_t *const dst[], const size_t dst_len[],
                            const int bytesperline[], int nb_mem_planes,
@@ -148,9 +212,10 @@ int ff_v4l2_enc_copy_frame(const AVFrame *src, enum AVPixelFormat dst_fmt,
     V4L2EncPlane pl[V4L2_ENC_MAX_PLANES];
     const int w = FFMIN(src->width,  fmt_width);
     const int h = FFMIN(src->height, fmt_height);
+    const int convert = src->format != dst_fmt;
     int p, nb_planes;
 
-    if (src->format != dst_fmt || w <= 0 || h <= 0)
+    if (!ff_v4l2_enc_can_convert(src->format, dst_fmt) || w <= 0 || h <= 0)
         return AVERROR(EINVAL);
 
     nb_planes = v4l2_enc_layout(dst_fmt, dst, dst_len, bytesperline,
@@ -159,15 +224,25 @@ int ff_v4l2_enc_copy_frame(const AVFrame *src, enum AVPixelFormat dst_fmt,
     if (nb_planes < 0)
         return nb_planes;
 
+    if (convert) {
+        if (!src->data[0] || !src->data[1] || !src->data[2])
+            return AVERROR(EINVAL);
+        v4l2_enc_convert(src, dst_fmt, pl, w, h);
+    }
+
     for (p = 0; p < nb_planes; p++) {
         const int rows  = is_chroma_plane(p) ? AV_CEIL_RSHIFT(h, desc->log2_chroma_h) : h;
         const int bytes = av_image_get_linesize(dst_fmt, w, p);
 
-        if (!src->data[p] || bytes < 0)
+        if (bytes < 0)
             return AVERROR(EINVAL);
 
-        av_image_copy_plane(pl[p].data, pl[p].stride,
-                            src->data[p], src->linesize[p], bytes, rows);
+        if (!convert) {
+            if (!src->data[p])
+                return AVERROR(EINVAL);
+            av_image_copy_plane(pl[p].data, pl[p].stride,
+                                src->data[p], src->linesize[p], bytes, rows);
+        }
         v4l2_enc_pad_plane(&pl[p], bytes, rows);
     }
 
diff --git a/libavcodec/v4l2_enc_utils.h b/libavcodec/v4l2_enc_utils.h
index 4804234..488ed76 100644
--- a/libavcodec/v4l2_enc_utils.h
+++ b/libavcodec/v4l2_enc_utils.h
@@ -27,9 +27,23 @@
 #include "libavutil/frame.h"
 #include "libavutil/pixfmt.h"
 
+/**
+ * @return 1 if ff_v4l2_enc_copy_frame() can copy a frame of format src into
+ *         a buffer of format dst (the same format, or planar 4:2:0 into
+ *         NV12/NV21/P010), 0 otherwise
+ */
+int ff_v4l2_enc_can_convert(enum AVPixelFormat src, enum AVPixelFormat dst);
+
+/**
+ * @return the OUTPUT format to ask the driver for when the frames are src:
+ *         src itself if V4L2 has a format for it, else one it converts to
+ */
+enum AVPixelFormat ff_v4l2_enc_request_fmt(enum AVPixelFormat src);
+
 /**
  * Copy a software frame into the memory of a V4L2 OUTPUT buffer, laid out
- * as the driver's format describes it.
+ * as the driver's format describes it, converting planar 4:2:0 frames to
+ * the semi-planar layout when the buffer is NV12, NV21 or P010.
  *
  * With one memory plane (single-planar NV12, P010, YUV420, ...) the planes
  * are contiguous: plane 0 has bytesperline[0] bytes per line and fmt_height
diff --git a/libavcodec/v4l2_m2m_enc.c b/libavcodec/v4l2_m2m_enc.c
index 325fe5a..6a13247 100644
--- a/libavcodec/v4l2_m2m_enc.c
+++ b/libavcodec/v4l2_m2m_enc.c
@@ -34,6 +34,7 @@
 #include "v4l2_context.h"
 #include "v4l2_m2m.h"
 #include "v4l2_fmt.h"
+#include "v4l2_enc_utils.h"
 
 #define MPEG_CID(x) V4L2_CID_MPEG_VIDEO_##x
 #define MPEG_VIDEO(x) V4L2_MPEG_VIDEO_##x
@@ -405,7 +406,7 @@ static av_cold int v4l2_encode_init(AVCodecContext *avctx)
 
     /* output context */
     output->av_codec_id = AV_CODEC_ID_RAWVIDEO;
-    output->av_pix_fmt = avctx->pix_fmt;
+    output->av_pix_fmt = ff_v4l2_enc_request_fmt(avctx->pix_fmt);
 
     /* capture context */
     capture->av_codec_id = avctx->codec_id;
@@ -424,11 +425,19 @@ static av_cold int v4l2_encode_init(AVCodecContext *avctx)
         v4l2_fmt_output = output->format.fmt.pix.pixelformat;
 
     pix_fmt_output = ff_v4l2_format_v4l2_to_avfmt(v4l2_fmt_output, AV_CODEC_ID_RAWVIDEO);
-    if (pix_fmt_output != avctx->pix_fmt) {
-        const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(pix_fmt_output);
-        av_log(avctx, AV_LOG_ERROR, "Encoder requires %s pixel format.\n", desc->name);
+    if (!ff_v4l2_enc_can_convert(avctx->pix_fmt, pix_fmt_output)) {
+        const char *name = av_get_pix_fmt_name(pix_fmt_output);
+        av_log(avctx, AV_LOG_ERROR, "Encoder requires %s pixel format (%s given); "
+               "convert with -pix_fmt %s or a format filter.\n",
+               name ? name : av_fourcc2str(v4l2_fmt_output),
+               av_get_pix_fmt_name(avctx->pix_fmt), name ? name : "...");
         return AVERROR(EINVAL);
     }
+    if (pix_fmt_output != avctx->pix_fmt)
+        av_log(avctx, AV_LOG_VERBOSE, "Converting %s frames to %s while copying them\n",
+               av_get_pix_fmt_name(avctx->pix_fmt), av_get_pix_fmt_name(pix_fmt_output));
+    /* the buffers' format; the frames stay avctx->pix_fmt */
+    output->av_pix_fmt = pix_fmt_output;
 
     ret = v4l2_set_output_crop(s);
     if (ret < 0)
